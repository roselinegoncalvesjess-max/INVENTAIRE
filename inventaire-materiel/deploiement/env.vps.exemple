# Modèle du fichier .env à placer à côté de docker-compose.yml sur le VPS :
#   cp deploiement/env.vps.exemple .env && chmod 600 .env
# puis remplacer le mot de passe (par exemple : openssl rand -hex 24).

# Mot de passe de la base PostgreSQL (fixé à la première création du volume)
PGPASSWORD=A_REMPLACER

# L'application n'écoute que sur la machine elle-même : Nginx fait l'intermédiaire
ADRESSE_APP=127.0.0.1
PORT_APP=3001

# Cookie de session envoyé uniquement en HTTPS
COOKIE_SECURE=1
